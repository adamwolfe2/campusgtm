# AI Provider API Keys (Model-Agnostic Architecture)
# Users can configure these via Settings UI or environment variables

# Google Gemini (Recommended - 2M token context)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Superior reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT (Versatile, with image generation)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (Optional - for future use)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Clerk Authentication (Optional - for future use)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
