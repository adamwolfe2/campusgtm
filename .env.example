# ==============================================================================
# Campus GTM - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# ==============================================================================
# DATABASE (REQUIRED)
# ==============================================================================
# Supabase PostgreSQL database configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (DANGEROUS - only use server-side, never expose to client)
# Only needed for admin operations that bypass RLS
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================================================================
# AUTHENTICATION (REQUIRED)
# ==============================================================================
# Clerk authentication configuration
# Get these from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ==============================================================================
# AI PROVIDERS (AT LEAST ONE REQUIRED)
# ==============================================================================
# Configure one or more AI providers for strategy generation

# Google Gemini (Recommended - 2M token context window)
# Get API key from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Superior reasoning, great for strategic thinking)
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT (Most versatile, includes image generation)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# COSS INFRASTRUCTURE (FUTURE - Coming Soon)
# ==============================================================================
# COSS unified infrastructure key for auth, video, calendar, mail, sms, payments
# Learn more: https://coss.com
# COSS_KEY=ITSTIMETOBUILD

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================

# Next.js Environment (defaults to development)
# NODE_ENV=production

# Application URL (for webhooks, email links, etc.)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# NOTES
# ==============================================================================
# - All NEXT_PUBLIC_* variables are exposed to the browser
# - Regular variables (without NEXT_PUBLIC_) are server-side only
# - Restart your dev server after changing environment variables
